 "To get pack
* SELECT quantitynumerator, alternativeunit, quantitydenominator, baseunit ,product
* FROM i_productunitsofmeasure WITH PRIVILEGED ACCESS
* WHERE product = @delivery_doc_changed_item_in-material
* INTO TABLE @DATA(lt_data).
*
* IF lt_data IS NOT INITIAL.
*   READ TABLE lt_data INTO DATA(ls_data) WITH KEY product  =   delivery_doc_changed_item_in-material
*                                                  alternativeunit = 'PAK'.
*
*   IF sy-subrc = 0.
*     LOOP AT lt_data INTO ls_data WHERE product EQ delivery_doc_changed_item_in-material
*                                  AND baseunit EQ  'CS'.
*       .
*       IF sy-subrc = 0.
*         DATA(lv_alternativeunit) = ls_data-alternativeunit.
*         IF lv_alternativeunit EQ 'PAK'.
*           DATA(lv_alternativeunit_final) = 'PAC'.
*         ENDIF.
*         DATA(lv_baseunit) = ls_data-baseunit.
*         IF lv_baseunit EQ 'CS'.
*           DATA(lv_baseunit_final) = 'CV'.
*         ENDIF.
*         DATA lv_quantitydenominator TYPE string.
*         lv_quantitydenominator = ls_data-quantitydenominator.
*         DATA lv_quantitynumerator TYPE string.
*         lv_quantitynumerator = ls_data-quantitynumerator.
*         DATA(lv_unitconv) = lv_quantitydenominator && lv_alternativeunit_final. " && ' ' && ' X ' && ' ' && lv_quantitynumerator && lv_baseunit_final .
*         .
*         delivery_doc_changed_item_out-yy1_pack2_dli = lv_unitconv.
*       ENDIF.
*     ENDLOOP.
*   ENDIF.
* ENDIF.

 SELECT product,alternativeunit,quantitynumerator,quantitydenominator,baseunit
  FROM i_productunitsofmeasure WITH PRIVILEGED ACCESS
  FOR ALL ENTRIES IN @delivery_document_items_in
  WHERE product = @delivery_document_items_in-material
  INTO TABLE @DATA(lt_data).

 IF sy-subrc = 0.
   READ TABLE lt_data INTO DATA(ls_packvalue) WITH KEY alternativeunit = 'PAK' baseunit = 'CS'.
   IF sy-subrc = 0.
     DATA(lv_alternativeunit_final) = 'PAC'.
     DATA(lv_baseunit_final) = 'CV'.
     DATA(lv_unitconv) = ls_packvalue-quantitydenominator && ' ' && lv_alternativeunit_final.
     delivery_doc_changed_item_out-yy1_pack2_dli = lv_unitconv.
   ENDIF.
 ENDIF.

