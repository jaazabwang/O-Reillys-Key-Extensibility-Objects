 DATA lv_sum TYPE c LENGTH 10.

 DATA lv_netweight   TYPE i_outbounddeliveryitem-itemnetweight.
 DATA lv_grossweight TYPE i_outbounddeliveryitem-itemgrossweight.

 SELECT outbounddelivery,outbounddeliveryitem,product,actualdeliveryquantity,itemgrossweight,itemnetweight
 FROM i_outbounddeliveryitem WITH PRIVILEGED ACCESS
 WHERE outbounddelivery    = @delivery_doc_changed_item_out-deliverydocument
 AND   material            = @delivery_doc_changed_item_out-material
 AND   referencesddocument = @delivery_doc_changed_item_out-referencesddocument
 INTO TABLE @DATA(lt_deliveredquantities).

 IF sy-subrc = 0.
   LOOP AT lt_deliveredquantities INTO DATA(ls_deliveredquantities).
     lv_sum = lv_sum + ls_deliveredquantities-actualdeliveryquantity.
     lv_netweight = lv_netweight + ls_deliveredquantities-itemnetweight.
     lv_grossweight = lv_grossweight + ls_deliveredquantities-itemgrossweight.
   ENDLOOP.
 ENDIF.
