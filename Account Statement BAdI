*    IF <fs_item>-clearingaccountingdocument IS NOT INITIAL.
*
*      " Search for a matching UNCLEARED entry
*      LOOP AT cs_account_statement-lineitemnode ASSIGNING FIELD-SYMBOL(<fs_match>)
*           WHERE clearingaccountingdocument IS INITIAL
*             AND companycode = <fs_item>-companycode
*             AND documentdate = <fs_item>-documentdate
*             AND accountingdocument = <fs_item>-accountingdocument.
*
*        <fs_item>-amountintransactioncurrency = <fs_item>-amountintransactioncurrency + <fs_match>-amountintransactioncurrency.
*        IF <fs_match>-amountintransactioncurrency < 0.
*          <fs_item>-customfield = <fs_match>-amountintransactioncurrency * -1.
*        ENDIF.
*        <fs_item>-documentreference = <fs_match>-documentreference.
*
*        lv_index_match = sy-tabix.
*
*        " Delete the matched UNCLEARED line
*        DELETE cs_account_statement-lineitemnode INDEX lv_index_match.
*
*        " Exit after first match
*        EXIT.
*      ENDLOOP.
*    ENDIF.
*  ENDIF.
*ENDLOOP.

