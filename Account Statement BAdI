"to read the Reversal and Reversed status of documents
DATA lv_count TYPE i.

SELECT companycode,fiscalyear,accountingdocument,accountingdocumenttype,isreversal,isreversed
FROM i_journalentry WITH PRIVILEGED ACCESS
FOR ALL ENTRIES IN @cs_account_statement-lineitemnode
WHERE companycode        = @cs_account_statement-lineitemnode-companycode
AND   accountingdocument = @cs_account_statement-lineitemnode-accountingdocument
AND   fiscalyear         = @cs_account_statement-lineitemnode-fiscalyear
AND   ( isreversal         = 'X' OR  isreversed = 'X' )
INTO TABLE @DATA(lt_documents).

LOOP AT lt_documents ASSIGNING FIELD-SYMBOL(<fs_deletedocuments>).
**** TO exclude the Reversal and reversed documents

  READ TABLE lt_documents  WITH KEY accountingdocument = <fs_deletedocuments>-accountingdocument
                                    isreversal = abap_true  TRANSPORTING NO FIELDS.
  IF sy-subrc = 0.
    DELETE cs_account_statement-lineitemnode WHERE accountingdocument = <fs_deletedocuments>-accountingdocument.
  ELSE.
    READ TABLE lt_documents  WITH KEY accountingdocument = <fs_deletedocuments>-accountingdocument
                                     isreversed = abap_true  TRANSPORTING NO FIELDS.
    IF sy-subrc = 0.
      DELETE cs_account_statement-lineitemnode WHERE accountingdocument = <fs_deletedocuments>-accountingdocument.
    ENDIF.
  ENDIF.
ENDLOOP.
********Mering DG Documents*******************JW: To merge the DG Documents comparing Assignment Reference and Journal Entry Date 01/07/2025
DATA lv_prevassignmentref TYPE c LENGTH 10.
DATA lv_prevjournalentrydate TYPE d.
DATA lv_prevamount TYPE p DECIMALS 2.
DATA lv_currentamount TYPE p DECIMALS 2.
DATA lv_prevreference TYPE c LENGTH 10.
DATA lv_currentref    TYPE c LENGTH 10.
DATA lv_firstline TYPE c LENGTH 1 VALUE abap_true.

LOOP AT cs_account_statement-lineitemnode ASSIGNING FIELD-SYMBOL(<fs_contracts>) WHERE accountingdocumenttype = 'DG'.
  ls_contracts-companycode                    = <fs_contracts>-companycode.
  ls_contracts-accountingdoucment             = <fs_contracts>-accountingdocument.
  ls_contracts-accountingdocumentcreationdate = <fs_contracts>-accountingdocumentcreationdate.
  ls_contracts-accountingdocumenttype         = <fs_contracts>-accountingdocumenttype.
  ls_contracts-assignmentreference            = <fs_contracts>-assignmentreference.
  ls_contracts-amountintransactioncurrency    = <fs_contracts>-amountintransactioncurrency.
  ls_contracts-originalreferencedocument      = <fs_contracts>-originalreferencedocument.
  APPEND ls_contracts TO lt_contracts.
ENDLOOP.

SORT lt_contracts ASCENDING BY originalreferencedocument accountingdocumentcreationdate.


LOOP AT lt_contracts INTO DATA(ls_documents).
  DATA(lv_assignmentref)    = ls_documents-assignmentreference.
  DATA(lv_journalentrydate) = ls_documents-accountingdocumentcreationdate.
***** to read the first line record
  IF lv_firstline = abap_true.
    lv_prevassignmentref = lv_assignmentref.
    lv_prevjournalentrydate = lv_journalentrydate.
    lv_currentamount = ls_documents-amountintransactioncurrency.
    lv_currentref        = ls_documents-originalreferencedocument.
    lv_firstline = abap_false.
***** to sum the amount comparing contract and date
  ELSEIF lv_assignmentref = lv_prevassignmentref AND lv_journalentrydate = lv_prevjournalentrydate.
    lv_currentamount = lv_currentamount + ls_documents-amountintransactioncurrency.
    lv_currentref    = ls_documents-originalreferencedocument.
  ELSE.
***** To append the firstline record
    ls_finalcontract-contract       = lv_prevassignmentref.
    ls_finalcontract-contractamount = lv_currentamount.
    ls_finalcontract-reference      = lv_currentref.
    APPEND ls_finalcontract TO lt_finalcontract.
    CLEAR lv_currentamount.
**** to read the values to compare with next iteration
    lv_prevassignmentref    = ls_documents-assignmentreference.
    lv_prevjournalentrydate = ls_documents-accountingdocumentcreationdate.
    lv_currentamount = ls_documents-amountintransactioncurrency.
    lv_currentref = ls_documents-originalreferencedocument.
  ENDIF.
ENDLOOP.
***** to append the last calculated values
IF lv_firstline = abap_false.
  ls_finalcontract-contract       = lv_prevassignmentref.
  ls_finalcontract-contractamount = lv_currentamount.
  ls_finalcontract-reference = lv_currentref.
  APPEND ls_finalcontract TO lt_finalcontract.
ENDIF.


LOOP AT cs_account_statement-lineitemnode ASSIGNING FIELD-SYMBOL(<fs_lineitems>).
  lv_count = lv_count + 1.
  CLEAR:<fs_lineitems>-customfield.
****exclude da and dv documents
  IF <fs_lineitems>-accountingdocumenttype = 'DA' OR <fs_lineitems>-accountingdocumenttype = 'DV'.
    DELETE cs_account_statement-lineitemnode WHERE accountingdocument = <fs_lineitems>-accountingdocument.
    CONTINUE.
  ENDIF.
***** Migrated Documents *********
  IF <fs_lineitems>-accountingdocumenttype = 'UE'.
    IF <fs_lineitems>-clearingaccountingdocument IS NOT INITIAL.
      <fs_lineitems>-customfield = '0.00'.
      CONDENSE <fs_lineitems>-customfield.
      <fs_lineitems>-amountincompanycodecurrency = '0.00'.
    ELSE.
      <fs_lineitems>-customfield = <fs_lineitems>-amountintransactioncurrency.
      CONDENSE <fs_lineitems>-customfield.
      <fs_lineitems>-amountincompanycodecurrency = <fs_lineitems>-amountintransactioncurrency.
    ENDIF.
  ENDIF.

******  "Invoice Logic*****
  IF <fs_lineitems>-accountingdocumenttype = 'DR' OR <fs_lineitems>-accountingdocumenttype = 'RE'
  OR <fs_lineitems>-accountingdocumenttype = 'KR' OR <fs_lineitems>-accountingdocumenttype = 'RV'.
    "CHECK IF PARTIAL PAYMENT OF INVOICE IS DONE
    IF <fs_lineitems>-clearingaccountingdocument IS NOT INITIAL AND is_corr_request-to_date < <fs_lineitems>-clearingdate. " to calculte O/S if to date < clearing date
      "read payment line referring invoice document = invoice ref of payment document
      READ TABLE cs_account_statement-lineitemnode INTO DATA(ls_partialpayment) WITH KEY invoicereference = <fs_lineitems>-accountingdocument accountingdocumenttype = 'DZ'.
      IF sy-subrc = 0.
        DATA(lv_paymentamount) = ls_partialpayment-amountintransactioncurrency.
        <fs_lineitems>-customfield = <fs_lineitems>-amountintransactioncurrency + lv_paymentamount.
        CONDENSE <fs_lineitems>-customfield.
        "For Form field binding purpose as this field is not used in the form
        <fs_lineitems>-amountincompanycodecurrency = <fs_lineitems>-amountintransactioncurrency + lv_paymentamount.
        "to update the same amount in the custom field when above logic fails
      ELSE.
        <fs_lineitems>-customfield = <fs_lineitems>-amountintransactioncurrency.
        "For Form field binding purpose as this field is not used in the form
        <fs_lineitems>-amountincompanycodecurrency = <fs_lineitems>-amountintransactioncurrency.
      ENDIF.
    ELSEIF <fs_lineitems>-clearingaccountingdocument IS NOT INITIAL.
      "if not partial payemnet to update as 0 when clearing document is present
      <fs_lineitems>-customfield = '0.00'.
      CONDENSE <fs_lineitems>-customfield.
      "For Form field binding purpose as this field is not used in the form
      <fs_lineitems>-amountincompanycodecurrency = '0.00'.
    ELSE.
      "to update the same amount if the Clearing Document is not present
      <fs_lineitems>-customfield = <fs_lineitems>-amountintransactioncurrency.
      CONDENSE <fs_lineitems>-customfield.
      "For Form field binding purpose as this field is not used in the form
      <fs_lineitems>-amountincompanycodecurrency = <fs_lineitems>-amountintransactioncurrency.
    ENDIF.
  ENDIF.

*********PAYMENT LOGIC*********
  IF <fs_lineitems>-accountingdocumenttype = 'ZP' OR <fs_lineitems>-accountingdocumenttype = 'DZ'.
    "OVER PAYMENT
    IF <fs_lineitems>-clearingaccountingdocument IS NOT INITIAL.
      <fs_lineitems>-customfield = '0.00'. "To display 0 when clearing is present
      CONDENSE <fs_lineitems>-customfield.
      "For Form field binding purpose as this field is not used in the form
      <fs_lineitems>-amountincompanycodecurrency = '0.00'.
    ELSE.
      "check for the payment line with the clearing document and get the cleared amount and delete the cleared line
      "add the amount in the uncleared payment line and display the initial pending amount before summing in the custom field
      READ TABLE cs_account_statement-lineitemnode ASSIGNING FIELD-SYMBOL(<fs_overpayment>) WITH KEY clearingaccountingdocument = <fs_lineitems>-accountingdocument accountingdocumenttype = 'DZ'.
      IF sy-subrc = 0 AND <fs_lineitems>-amountintransactioncurrency <> <fs_overpayment>-amountintransactioncurrency.
        DATA(lv_paydamount) = <fs_overpayment>-amountintransactioncurrency.
        DELETE cs_account_statement-lineitemnode INDEX sy-tabix.
        <fs_lineitems>-customfield = <fs_lineitems>-amountintransactioncurrency.
        CONDENSE <fs_lineitems>-customfield.
        "For Form field binding purpose as this field is not used in the form
        <fs_lineitems>-amountincompanycodecurrency = <fs_lineitems>-amountintransactioncurrency.
        <fs_lineitems>-amountintransactioncurrency = <fs_lineitems>-amountintransactioncurrency + lv_paydamount.

      ELSE.
        "to display 0 when the partial payment entry does not have the clearing but has the invoice ref .
        "compare the amount with invoice ref and payment amount < invoice refer amount show the payment amount O/s as 0
        READ TABLE cs_account_statement-lineitemnode INTO DATA(ls_paymentdone) WITH KEY accountingdocument = <fs_lineitems>-invoicereference accountingdocumenttype = 'DR'.
        IF sy-subrc = 0.
          IF ls_paymentdone-amountintransactioncurrency > <fs_lineitems>-amountintransactioncurrency.
            <fs_lineitems>-customfield = '0.00'.
            CONDENSE <fs_lineitems>-customfield.
            "For Form field binding purpose as this field is not used in the form
            <fs_lineitems>-amountincompanycodecurrency = '0.00'.
          ENDIF.
        ENDIF.
      ENDIF.
    ENDIF.
  ENDIF.
*********** Merging Contracts Logic ***********  JW: To merge the DG Documents comparing Assignment Reference and Journal Entry Date 01/07/2025
  IF <fs_lineitems>-accountingdocumenttype = 'DG'.
    READ TABLE lt_finalcontract INTO DATA(ls_dgdocuments) WITH KEY contract  = <fs_lineitems>-assignmentreference
                                                                   reference = <fs_lineitems>-originalreferencedocument.
    IF sy-subrc = 0.
      <fs_lineitems>-amountintransactioncurrency = ls_dgdocuments-contractamount.
      <fs_lineitems>-customfield                 = ls_dgdocuments-contractamount.
      <fs_lineitems>-amountincompanycodecurrency = ls_dgdocuments-contractamount.
      <fs_lineitems>-originalreferencedocument   = ls_dgdocuments-contract.
    ELSE.
      DELETE cs_account_statement-lineitemnode WHERE assignmentreference     = <fs_lineitems>-assignmentreference
                                               AND originalreferencedocument = <fs_lineitems>-originalreferencedocument.
    ENDIF.
  ENDIF.
ENDLOOP.

*** To add the totals of O/S balance in balance line item node -- JW: 02/06/2025
DATA lv_gbpsum TYPE p DECIMALS 2.
DATA lv_eursum TYPE p DECIMALS 2.
DATA lv_gbpcarriedsum TYPE p DECIMALS 2.
DATA lv_eurcarriedsum TYPE p DECIMALS 2.

*** Calculate totals of O/S Totals Column

LOOP AT cs_account_statement-lineitemnode INTO DATA(ls_ostotals).
  IF ls_ostotals-transactioncurrency = 'GBP'.
*  lv_gbpsum = lv_gbpsum + ls_ostotals-customfield.
    lv_gbpsum = lv_gbpsum + ls_ostotals-amountincompanycodecurrency.

  ELSE.
*  lv_eursum = lv_eursum + ls_ostotals-customfield.
    lv_eursum = lv_eursum + ls_ostotals-amountincompanycodecurrency.
  ENDIF.
ENDLOOP.

*** Calculate Total of Carried Forward Balance
LOOP AT cs_account_statement-balancecarriedopenitemnode INTO DATA(ls_balancecarriedforward).
  IF ls_balancecarriedforward-transactioncurrency = 'GBP'.
    lv_gbpcarriedsum = lv_gbpcarriedsum + ls_balancecarriedforward-amountintransactioncurrency.
  ELSE.
    lv_eurcarriedsum = lv_eurcarriedsum + ls_balancecarriedforward-amountintransactioncurrency.
  ENDIF.
ENDLOOP.

** To update the balance item nodes fields as there are no custom fields to map and standard calulated balance line item node std values are not displayed in the form
cs_account_statement-balancelineitemnode[ 1 ]-amountincompanycodecurrency = lv_gbpsum + lv_gbpcarriedsum.
cs_account_statement-balancelineitemnode[ 1 ]-amountintransactioncurrency = lv_eursum + lv_eurcarriedsum.
