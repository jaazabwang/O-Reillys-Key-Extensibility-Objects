FROM i_billingdocitemprcgelmntbasic WITH PRIVILEGED ACCESS
WHERE billingdocument     = @billingdocitem-billingdocument
AND   billingdocumentitem = @billingdocitem-billingdocumentitem
AND ( conditiontype = 'ZPRM' ) "OR conditiontype = 'ZDS1' "JW:To only consider ZPRM condition -- 20/05/2025
