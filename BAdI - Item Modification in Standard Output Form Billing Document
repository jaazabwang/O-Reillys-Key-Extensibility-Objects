*    OR conditiontype = 'ZDS6' OR conditiontype = 'ZDS7'
*    OR conditiontype = 'ZCON' )
INTO @DATA(ls_itemconditions).

IF billingdocitem-billingquantity <> 0.
  IF ls_itemconditions IS NOT INITIAL.
    billingdocitem_ext_out-yy1_promotionapplcbl_bdi = '*P*'.
  ELSE.
    billingdocitem_ext_out-yy1_promotionapplcbl_bdi = '*N*'.
  ENDIF.
ELSE.
  billingdocitem_ext_out-yy1_promotionapplcbl_bdi = '*O/S*'.
ENDIF.
