"to supply the required quantity in sup Qty field in form
SELECT SINGLE *
FROM i_outbounddeliveryitem WITH PRIVILEGED ACCESS
WHERE outbounddelivery     = @billingdocitem-referencesddocument
AND   outbounddeliveryitem = @billingdocitem-referencesddocumentitem
INTO @DATA(ls_delivery).

IF sy-subrc = 0.
  SELECT SINGLE *
  FROM i_salesdocumentitem WITH PRIVILEGED ACCESS
  WHERE salesdocument     = @ls_delivery-referencesddocument
  AND   salesdocumentitem = @ls_delivery-referencesddocumentitem
  INTO @DATA(ls_orderquantity).
  IF sy-subrc = 0.
    "to pass the order quantity in the Ord QTY col -- Invoice Form 16/05/2025
    IF billingdocitem_ext_out-yy1_supqtybillingform_bdi IS INITIAL.
      billingdocitem_ext_out-yy1_supqtybillingform_bdi = ls_orderquantity-orderquantity.
    ENDIF.
  ENDIF.
ENDIF.

*to get the material size and alternative UOM

SELECT SINGLE *
FROM i_product WITH PRIVILEGED ACCESS
WHERE product = @billingdocitem-product
INTO @DATA(ls_product).

IF sy-subrc = 0.
  billingdocitem_ext_out-yy1_size1_bdi         = ls_product-sizeordimensiontext.
  billingdocitem_ext_out-yy1_suppliercode1_bdi = ls_product-productstandardid.
  billingdocitem_ext_out-yy1_billdiscntgrp_bdi = ls_product-yy1_discountgroup_prd.
ENDIF.

****To calculate drs levy and drs value based on customer country
SELECT SINGLE a~customer,a~country,b~iseuropeanunionmember
FROM i_customer WITH PRIVILEGED ACCESS AS a
INNER JOIN i_country AS b
ON b~country = a~country
WHERE customer  = @billingdoc-soldtoparty
AND   b~country = 'IE'
INTO @DATA(ls_customereumember).

IF sy-subrc = 0.
  billingdocitem_ext_out-yy1_drslevy_bdi = ls_product-yy1_drslevys_prd.
  billingdocitem_ext_out-yy1_drsvalue_bdi = ls_product-yy1_drsunits_prd * ls_product-yy1_drslevys_prd * billingdocitem-billingquantity.
ELSE.
  billingdocitem_ext_out-yy1_drslevy_bdi = ' '.
  billingdocitem_ext_out-yy1_drsvalue_bdi = ' '.
ENDIF.

*to get the alternative UOM
SELECT alternativeunit,quantitynumerator,quantitydenominator,baseunit
FROM i_productunitsofmeasure WITH PRIVILEGED ACCESS
WHERE product = @billingdocitem-product
INTO TABLE @DATA(lt_unit).

IF sy-subrc = 0.
  " To get pack value.
  LOOP AT lt_unit INTO DATA(ls_unit) WHERE alternativeunit = 'PAK'.
    billingdocitem_ext_out-yy1_pack_bdi = ls_unit-quantitydenominator.
  ENDLOOP.
  " to get CAN VALUE.
  LOOP AT lt_unit INTO ls_unit WHERE alternativeunit = 'KAN'.
    billingdocitem_ext_out-yy1_can_bdi = ls_unit-quantitydenominator.
  ENDLOOP.
ENDIF.

*to get the sales representative
SELECT SINGLE *
FROM i_billingdocument WITH PRIVILEGED ACCESS
WHERE billingdocument = @billingdoc-billingdocument
INTO @DATA(ls_rp).

IF sy-subrc = 0.
  billingdocitem_ext_out-yy1_salerepresentative_bdi = ls_rp-yy1_salesreprsntative_bdh.
ENDIF.

"TO GET TAX PERCENTAGE BASED ON CONDITION TYPE TTX1
SELECT SINGLE *
FROM i_billingdocitemprcgelmntbasic WITH PRIVILEGED ACCESS
WHERE billingdocument     = @billingdocitem-billingdocument
AND   billingdocumentitem = @billingdocitem-billingdocumentitem "JW: Added item condition -- 08/05/2025
AND conditiontype         = @cv_ttx1
INTO @DATA(ls_vatprcnt).

IF sy-subrc = 0.
  lv_vat     = ls_vatprcnt-conditionratevalue.
  lv_taxrate = ls_vatprcnt-conditionratevalue / 100.

  billingdocitem_ext_out-yy1_taxrate_bdi = lv_taxrate.

  CONDENSE billingdocitem_ext_out-yy1_taxrate_bdi.
  lv_taxcode = ls_vatprcnt-taxcode.
  IF billingdocitem_ext_out-yy1_taxcode_bdi IS INITIAL.
    billingdocitem_ext_out-yy1_taxcode_bdi = ls_vatprcnt-taxcode.
  ENDIF.
ENDIF.

**** To check if ZPRP exists then consider the ZPRP value else consider the ZRRP value 12/05/2025
"To get the value of ZPRP condition Type
SELECT SINGLE *
FROM i_billingdocitemprcgelmntbasic WITH PRIVILEGED ACCESS
WHERE billingdocument     = @billingdocitem-billingdocument
AND   billingdocumentitem = @billingdocitem-billingdocumentitem  "JW: Added item condition -- 08/05/2025
AND   conditiontype       = @cv_zprp
INTO @DATA(ls_prp).

IF sy-subrc = 0.
  lv_rate = ls_prp-conditionratevalue.
ELSE.
  "To get the value of ZRRP condition Type
  SELECT SINGLE *
  FROM i_billingdocitemprcgelmntbasic WITH PRIVILEGED ACCESS
  WHERE billingdocument     = @billingdocitem-billingdocument
  AND   billingdocumentitem = @billingdocitem-billingdocumentitem  "JW: Added item condition -- 08/05/2025
  AND   conditiontype       = @cv_zrrp
  INTO @DATA(ls_rrp).
  IF sy-subrc = 0.
    lv_rate = ls_rrp-conditionratevalue.
  ENDIF.
ENDIF.

IF billingdocitem_ext_out-yy1_conditionvalue_bdi IS INITIAL.
  billingdocitem_ext_out-yy1_conditionvalue_bdi = lv_rate.
ENDIF.


"Net Amount
*lv_sp = billingdocitem-netamount.
** to get the each quantity amount
*lv_sp = billingdocitem-netamount / billingdocitem-billingquantity.
"TO PICK SUBTOTAL VALUE --- 15/05/2025
lv_sp = billingdocitem-subtotal1amount / billingdocitem-billingquantity.
CONDENSE lv_sp.
IF lv_sp IS INITIAL.
  lv_sp = 1.
ENDIF.
"Pack
lv_pack = billingdocitem_ext_out-yy1_pack_bdi.
CONDENSE lv_pack.
IF lv_pack IS INITIAL.
  lv_pack = 1.
ENDIF.

** JW: TO assign VAT as per the Tax Codes -- 12/05/2025
IF lv_taxcode = 'A0' OR lv_taxcode = 'A2' OR lv_taxcode = 'A3' OR lv_taxcode = 'A9'.
  lv_vat = '1'.
ELSEIF lv_taxcode = 'A5'.
  lv_vat = '1.135'.
ELSEIF lv_taxcode = 'A6'.
  lv_vat = '5'.
ELSEIF lv_taxcode = 'A1' AND billingdoc-companycode = 'UK01'.
  lv_vat = '1.20'.
  billingdocitem_ext_out-yy1_taxrate_bdi = '0.20'.
ELSEIF lv_taxcode = 'A1' AND billingdoc-companycode = 'IE01'.
  billingdocitem_ext_out-yy1_taxrate_bdi = '0.23'.
  lv_vat = '1.23'.
ENDIF.

"To calculate POR *=(((pack*rrp/vat)-sell price)/(pack*rrp/vat))
"POR will be zero if ( billing quantity )Sup Qty is Zero -- 16/05/2025
IF billingdocitem-billingquantity <> 0.
  lv_por = ( ( ( lv_pack * lv_rate / lv_vat ) - lv_sp ) / ( lv_pack * lv_rate / lv_vat ) ) * 100.
  lv_por_final = trunc( lv_por * 100 ) / 100.
  IF lv_por < 0.
    lv_por = lv_por * -1.
  ENDIF.
ELSE.
  lv_por = 0.
ENDIF.
billingdocitem_ext_out-yy1_por_bdi = lv_por_final.
CONDENSE billingdocitem_ext_out-yy1_por_bdi.

